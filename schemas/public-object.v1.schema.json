{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qed-artifacts/dictionary-of-quality-content/blob/main/schemas/public-object.v1.schema.json",
  "title": "Released Dictionary of Quality glossary object",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "object_id", "revision_id", "headword", "scope_label", "definition", "explanation", "references", "content_license", "review"],
  "properties": {
    "schema": {"const": "qed-glossary-public-object-v1"},
    "object_id": {"type": "string", "pattern": "^glossary\\.[a-z0-9]+([.-][a-z0-9]+)*$"},
    "revision_id": {"type": "string", "pattern": "^revision\\.glossary\\.[a-f0-9]{24}$"},
    "headword": {"type": "string", "minLength": 1},
    "scope_label": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "explanation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "url", "locators"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "content_license": {"const": "CC0-1.0"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_editorial", "owner_source_attestation", "internal_validation", "owner_release_authorization", "independent_external_review"],
      "properties": {
        "owner_editorial": {"const": true},
        "owner_source_attestation": {"const": true},
        "internal_validation": {"const": true},
        "owner_release_authorization": {"const": true},
        "independent_external_review": {"type": "boolean"}
      }
    }
  }
}
